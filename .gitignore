artifacts/masks/*
artifacts/geojson/*
artifacts/reports/*
artifacts/scenes/*
artifacts/checkpoints/*
artifacts/uploads/**
artifacts/masks/**
artifacts/geojson/**
artifacts/reports/**
artifacts/scenes/**
artifacts/checkpoints/**
!artifacts/uploads/.gitkeep
!artifacts/masks/.gitkeep
!artifacts/geojson/.gitkeep
!artifacts/reports/.gitkeep
!artifacts/scenes/.gitkeep
!artifacts/checkpoints/.gitkeep

# ---- Secrets, local environment & temporary working directories ----
.env
.env.local
.env.*.local
.env.example
*.pem
Temp/
temp/
tmp/
# ---- Implementation plans, status reports & scratch scripts (NEVER commit) ----
INTEGRATION_STATUS_REPORT.md
SatQuery_LangGraph_LangChain_Architecture_v3.md
*Plan*.md
*plan*.md
docs/*Plan*.md
docs/*plan*.md
scripts/

