# ---- Local state, metadata DB, runtime artifacts ----
var/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
backend/app.db
*.log
logs/

# Stored uploads, masks, overlays, reports and checkpoints are runtime data
