  "official_source_url": "https://bigearth.net/static/documents/Description_BigEarthNet_v2.pdf",
  "policy": "This is an explicit SAR-FuseSeg aggregation of official CLC Level-3 codes; it is not the BigEarthNet 19-class nomenclature. Every code not listed in mappings maps to ignore_index. This includes 0 (nodata), 999 (Unlabeled), 141 (Green urban areas, excluded due to high spectral/SAR ambiguity with vegetation, consistent with BigEarthNet 19-class treatment), and 331/332/334/335 (beaches, bare rock, burnt areas, glaciers -- previously aggregated into a fourth 'other' class that held 0.02% of labelled pixels across too few, too heterogeneous surfaces to learn; run 1 scored it 0.0006 IoU. Dropping it removed a class the model could not have been made to predict, rather than reporting a headline mIoU dragged down by a class with no learnable signal.)",
  "target_classes": {
    "0": "built-up",
    "1": "water",
    "2": "vegetation"
  }
