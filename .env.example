# SatQuery AI — backend configuration example
# Copy to .env at the repo root and adjust. Every value below is the built-in default
# unless stated otherwise, so the API also runs with no .env file at all.

# ---- Service ----
SATQUERY_APP_NAME=SatQuery AI API
SATQUERY_ENV=development                 # development | production | test
SATQUERY_API_PREFIX=/api/v1
SATQUERY_LOG_LEVEL=INFO
# Comma separated. Empty string disables CORS entirely.
SATQUERY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# ---- Storage ----
# Repo-relative or absolute. Holds uploads, masks, overlays, reports, checkpoints.
SATQUERY_ARTIFACTS_DIR=artifacts
# Local metadata database (SQLite for MVP, PostgreSQL later).
SATQUERY_STATE_DIR=var
# Resolution order: SATQUERY_DATABASE_URL, DATABASE_URL_POOLED, DATABASE_URL,
# then the SQLite default below. PostgreSQL URLs use Psycopg 3 automatically.
SATQUERY_DATABASE_URL=sqlite:///var/satquery.db
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DATABASE_URL_POOLED=postgresql://user:password@pooler-host/database?sslmode=require

# ---- Upload limits (section 8.1) ----
SATQUERY_MAX_UPLOAD_BYTES=524288000           # 500 MB compressed
SATQUERY_MAX_DECOMPRESSED_BYTES=2147483648    # 2 GB estimated in-memory raster
SATQUERY_MAX_RASTER_PIXELS=268435456          # 16384 x 16384
SATQUERY_MAX_FILES_PER_ANALYSIS=2

# ---- Pair validation (sections 8.3, 4.4) ----
# Minimum geographic overlap before a pair is considered the same location.
SATQUERY_MIN_OVERLAP_PERCENT=20.0
# Maximum residual misalignment, in source pixels, tolerated before inference.
# LEFT UNSET BY DESIGN: the plan requires a validated threshold (section 4.4) and
# refuses to silently co-register anything. When unset, alignment is reported as
# unknown and the affected workflows are rejected rather than guessed.
# SATQUERY_MAX_RESIDUAL_OFFSET_PIXELS=1.5

# ---- Asynchronous execution (section 7.0) ----
# rq     = Redis + RQ, GPU worker in a separate process (mandatory for real runs)
# inline = single in-process worker thread, development only, never for benchmarks
SATQUERY_QUEUE_MODE=inline
SATQUERY_REDIS_URL=redis://localhost:6379/0
SATQUERY_JOB_TIMEOUT_SECONDS=3600
# MVP GPU policy: exactly one analysis at a time.
SATQUERY_GPU_CONCURRENCY=1

# ---- Pipeline seam ----
# unattached = default; queued analyses fail fast with PIPELINE_NOT_ATTACHED
# stub       = shaped, honest, non-authoritative responses for frontend wiring
# python     = import SATQUERY_PIPELINE_CALLABLE and run it
SATQUERY_PIPELINE_MODE=unattached
SATQUERY_PIPELINE_CALLABLE=app.pipeline.runner.execute

# ---- Model registry / calibration (sections 4.2, 11) ----
SATQUERY_MODEL_REGISTRY_PATH=backend/app/config/model_registry.json
SATQUERY_CONFIDENCE_POLICY_PATH=backend/app/config/confidence_policies.json

# ---- Reports ----
SATQUERY_REPORT_BASE_URL=
SATQUERY_PUBLIC_BASE_URL=

# ---- Docker only: URL the containerized worker uses to reach Redis ----
# REDIS_URL=redis://redis:6379/0
